# Copy to .env and adjust per machine. Everything here is optional — config/config.yaml
# provides defaults that work out of the box. .env is gitignored (machine-specific).

# Override the auto-commit toggle without editing config.yaml (true/false).
# AUTO_COMMIT=true

# Override where the pipeline treats the bundle root as. Defaults to the repo checkout
# location (three directories up from src/okeef/config.py), which is correct as long as
# you don't move the src/ layout relative to the bundle root.
# OKEEF_ROOT=D:\OKEEF

# The Open WebUI Knowledge collection ID that openwebui_sync.py pushes concept docs
# into. This is per-machine (each Open WebUI instance generates its own UUID when you
# create the "OKEEF Bundle" collection during setup), so it belongs here, not in the
# shared config/config.yaml. See README.md for how to create the collection and get
# this value.
# OPENWEBUI_KNOWLEDGE_ID=

# Auto-creates the Open WebUI admin account headlessly on first startup (no browser
# signup needed). Required the first time you start Open WebUI on a new machine;
# after that account exists, these can be removed (they're only read on empty-DB
# startup) -- but leaving them is harmless since Open WebUI won't recreate the account.
# WEBUI_ADMIN_EMAIL=
# WEBUI_ADMIN_PASSWORD=
# WEBUI_ADMIN_NAME=
